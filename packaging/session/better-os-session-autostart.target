[Unit]
Description=XDG autostart entries and the file search index in the Better OS session
# The launcher starts this after better-os-session.target, and nothing else
# wants it. These two are not wanted by better-os-session.target itself:
# a condition skips only its own unit, never the units it wants
# (systemd.unit(5)), so a start of that target under GNOME would still have
# started every autostart entry and Tracker beside GNOME's own.
PartOf=better-os-session.target
After=better-os-session.target
ConditionPathExists=%t/better-os/session/restore.json
Wants=xdg-desktop-autostart.target
# Before, never after: a target is ordered after what it wants unless told
# otherwise, and the autostart entries are After=graphical-session.target,
# which is after better-os-session.target, so the implicit order is a cycle
# and systemd drops every autostart entry to break it (seen on Zorin OS 18.1).
Before=xdg-desktop-autostart.target
# The file search index, where it is installed. Its own unit is
# WantedBy=gnome-session.target only, so nothing else starts it here.
Wants=tracker-miner-fs-3.service
