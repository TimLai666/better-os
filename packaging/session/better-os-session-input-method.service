[Unit]
Description=Fcitx 5 input method in the Better OS session
# Wayland clients reach it through zwp_input_method_v2 and text-input-v3, Qt
# through QT_IM_MODULE=fcitx, X11 through XMODIFIERS=@im=fcitx (ADR 0038 C4).
PartOf=better-os-session.target
After=better-os-session.target

[Service]
Slice=session.slice
ExecStart=/usr/bin/fcitx5 --replace
Restart=on-failure
RestartSec=1
