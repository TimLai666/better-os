// The Better OS session's system actions: the command each System(...) key
// binding runs (engineering/specs/better-os-session.md, "Media keys"). Based
// on cosmic-settings-daemon's data/system_actions.ron (System76,
// GPL-3.0-or-later) at a8d9d84; packaging/session/cosmic/upstream.tsv records
// the upstream file this replaces.
//
// This directory replaces COSMIC's /usr/share/cosmic/com.system76.CosmicSettings.Shortcuts/v1/
// in the session: cosmic-config takes a configuration's defaults from the
// first XDG_DATA_DIRS entry that has its directory, and the launcher puts
// /usr/share/better-os/session first. So every action the session's
// `defaults` binds is here, and every program named is one the session's
// packages install (crates/session-launcher/tests/shortcuts.rs).
//
// Actions with no Better OS program yet are left out, and no key binds them:
// AppLibrary (Super+A, the owner's decision S3, ticket 210), WindowSwitcher
// and WindowSwitcherPrevious (Alt+Tab, ticket 211), and WorkspaceOverview
// (Super+W, ticket 212).
{
    BrightnessDown: "busctl --user call com.system76.CosmicSettingsDaemon /com/system76/CosmicSettingsDaemon com.system76.CosmicSettingsDaemon DecreaseDisplayBrightness",
    BrightnessUp: "busctl --user call com.system76.CosmicSettingsDaemon /com/system76/CosmicSettingsDaemon com.system76.CosmicSettingsDaemon IncreaseDisplayBrightness",
    DisplayToggle: "cosmic-osd display",
    InputSourceSwitch: "busctl --user call com.system76.CosmicSettingsDaemon /com/system76/CosmicSettingsDaemon com.system76.CosmicSettingsDaemon InputSourceSwitch",
    HomeFolder: "xdg-open ~",
    // cosmic-osd confirms, then calls com.system76.CosmicSession.Exit, which
    // the session launcher answers.
    LogOut: "cosmic-osd log-out",
    Launcher: "better-launcher",
    LockScreen: "loginctl lock-session",
    Mute: "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    MuteMic: "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    PlayPause: "playerctl play-pause",
    PlayNext: "playerctl next",
    PlayPrev: "playerctl previous",
    PowerOff: "cosmic-osd shutdown",
    // Better Screenshot (ticket 253): Print opens its interface.
    Screenshot: "better-screenshot",
    Suspend: "systemctl suspend",
    ScreenReader: "busctl --user call com.system76.CosmicSettingsDaemon /com/system76/CosmicSettingsDaemon com.system76.CosmicSettingsDaemon ScreenReader",
    // The machine's default terminal (Debian's alternative), since COSMIC's
    // terminal is not installed.
    Terminal: "x-terminal-emulator",
    TouchpadToggle: "cosmic-osd touchpad",
    VolumeLower: "busctl --user call com.system76.CosmicSettingsDaemon /com/system76/CosmicSettingsDaemon com.system76.CosmicSettingsDaemon VolumeDown",
    VolumeRaise: "busctl --user call com.system76.CosmicSettingsDaemon /com/system76/CosmicSettingsDaemon com.system76.CosmicSettingsDaemon VolumeUp",
    WebBrowser: "xdg-open http://",
}
