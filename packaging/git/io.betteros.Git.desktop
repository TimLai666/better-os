[Desktop Entry]
Type=Application
Version=1.0
Name=Better Git
Name[zh_TW]=Better Git
GenericName=Git Client
GenericName[zh_TW]=Git 用戶端
Comment=Work with Git repositories and GitHub without a terminal
Comment[zh_TW]=不用終端機就能使用 Git 儲存庫與 GitHub
Exec=better-git
Icon=better-git
Terminal=false
StartupNotify=true
# This file's name is the window's Wayland app_id (crates/git-gui/src/app.rs),
# which is how the shell matches the window to this entry. StartupWMClass says
# the same for X11.
StartupWMClass=io.betteros.Git
Categories=Development;RevisionControl;
Keywords=git;github;repository;commit;diff;branch;pull request;version control;
Keywords[zh_TW]=git;github;儲存庫;提交;差異;分支;拉取要求;版本控制;
