[Unit]
Description=Better OS component transaction service
Documentation=https://github.com/TimLai666/better-os/blob/main/engineering/decisions/0007-privileged-daemon-ipc.md

[Service]
Type=dbus
BusName=org.betteros.Manager1
ExecStart=/usr/libexec/better-manager-daemon
# The daemon exits on its own once idle. D-Bus activation starts it again on
# the next request, so a package manager that is not managing packages is not
# running.
Restart=no

# Hardening. See ADR 0007 for why the obvious remaining options are absent:
# NoNewPrivileges is inherited by dpkg maintainer scripts that may legitimately
# exec setuid helpers, ProtectSystem would stop dpkg writing /usr and /etc, and
# PrivateNetwork would stop apt fetching dependencies from the archives.
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
# ProtectKernelTunables makes /sys read-only. The two hardware writes (ADR
# 0017, ticket 86) are opened again here and nowhere else, each at the
# narrowest directory that holds it: the battery's own device directory,
# reached through its class link (systemd resolves the link to the device),
# and the platform device of the fan switch, whose hwmonN below it changes
# between boots. "-" skips a path this machine does not have. These names are
# hardware_platform::sysfs::BATTERY_NAMES and FAN_PLATFORM_DEVICES; a test
# holds the two lists together.
ReadWritePaths=-/sys/class/power_supply/BAT0 -/sys/class/power_supply/BAT1
ReadWritePaths=-/sys/class/power_supply/BAT2 -/sys/class/power_supply/BATT
ReadWritePaths=-/sys/devices/platform/asus-nb-wmi
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
DevicePolicy=closed

# There is deliberately no [Install] section: this unit is only ever started by
# D-Bus activation, never enabled at boot.
