<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>Better OS</vendor>
  <vendor_url>https://github.com/TimLai666/better-os</vendor_url>

  <action id="org.betteros.manager.apply-transaction">
    <description>Install, update, remove, or restore Better OS components</description>
    <description xml:lang="zh_TW">安裝、更新、移除或還原 Better OS 元件</description>
    <message>Authentication is required to change Better OS components</message>
    <message xml:lang="zh_TW">變更 Better OS 元件需要驗證身分</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <!-- A person installing one component and then updating another should
           not be asked twice inside polkit's keep window. Remote and inactive
           sessions always authenticate again. -->
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <!-- ADR 0014. dpkg configure -a finishes every package dpkg left unfinished,
       including packages Better OS did not install, and runs their maintainer
       scripts as root. Every session authenticates every time; nothing is
       kept between repairs. -->
  <action id="org.betteros.manager.repair-package-system">
    <description>Finish a package installation that was interrupted</description>
    <description xml:lang="zh_TW">完成被中斷的套件安裝</description>
    <message>Authentication is required to finish an interrupted package installation</message>
    <message xml:lang="zh_TW">完成被中斷的套件安裝需要驗證身分</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <!-- ADR 0017, ticket 86. Each hardware control has its own action, so an
       administrator can allow one without the other. The daemon accepts only
       60, 80, or 100 and only auto or full, and finds the file itself. -->
  <action id="org.betteros.manager.set-charge-limit">
    <description>Change the battery charge limit</description>
    <description xml:lang="zh_TW">變更電池充電上限</description>
    <message>Authentication is required to change the battery charge limit</message>
    <message xml:lang="zh_TW">變更電池充電上限需要驗證身分</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="org.betteros.manager.set-fan-mode">
    <description>Change the fan mode</description>
    <description xml:lang="zh_TW">變更風扇模式</description>
    <message>Authentication is required to change the fan mode</message>
    <message xml:lang="zh_TW">變更風扇模式需要驗證身分</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <!-- ADR 0034, ticket 136. Reads the keyboard's LampArray and sets one
       colour and intensity, or gives the lighting back to the firmware, or
       sets one of four kbd_rgb_mode effects. The daemon finds the device
       itself and builds every report; a caller sends an effect name from a
       closed set and five numbers. The person at the machine is not asked,
       as UPower does not ask for the keyboard brightness; a remote or
       inactive session authenticates. -->
  <action id="org.betteros.manager.keyboard-lighting">
    <description>Change the keyboard's colour</description>
    <message>Authentication is required to change the keyboard's colour</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <!-- ADR 0032, ticket 127. Writes only Better OS's own lines in /etc/fstab
       and its own udev rules file, for a drive the daemon looks up itself
       from a UUID. Asked once, then kept for a few minutes. -->
  <action id="org.betteros.manager.drive-mounting">
    <description>Choose which drives mount automatically</description>
    <description xml:lang="zh_TW">選擇要自動掛載的磁碟</description>
    <message>Authentication is required to change which drives mount automatically</message>
    <message xml:lang="zh_TW">變更要自動掛載的磁碟需要驗證身分</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <!-- ADR 0033, ticket 140. Turns the login screen watch off or on: one
       boolean in /var/lib/better-os/boot-watch/settings.json, nothing else. -->
  <action id="org.betteros.manager.login-screen-watch">
    <description>Turn the login screen watch on or off</description>
    <description xml:lang="zh_TW">開啟或關閉登入畫面守護</description>
    <message>Authentication is required to change the login screen watch</message>
    <message xml:lang="zh_TW">變更登入畫面守護需要驗證身分</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
