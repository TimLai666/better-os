[Unit]
Description=Better OS login screen watch
Documentation=https://github.com/TimLai666/better-os/blob/main/engineering/decisions/0033-login-screen-watch.md
# Once per boot (ADR 0033, ticket 140): if GDM starts and its login screen is
# not there 30 seconds later, record why and restart GDM once. The program
# itself waits for GDM, so nothing here orders this unit after it.
#
# Off the boot's critical path: with DefaultDependencies=no, graphical.target
# gains no After= on this unit from wanting it, so nothing waits for it.
DefaultDependencies=no
After=sysinit.target dbus.service systemd-logind.service
Wants=dbus.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
# Once per boot: a later `systemctl start` finds it active and runs nothing.
# The program also refuses a boot it already recorded.
RemainAfterExit=yes
ExecStart=/usr/libexec/better-manager-daemon --watch-login-screen
# The program gives up well inside this: 60 s for GDM to start, 30 s for the
# login screen, the evidence, and 30 s after the restart.
TimeoutStartSec=180
# The records directory, 0755, with the public files 0644 (the setting, the
# last boot, the summary). The program keeps the evidence, journal excerpts,
# in its evidence/ subdirectory, 0750 root:adm with 0640 files (ADR 0033).
StateDirectory=better-os/boot-watch
StateDirectoryMode=0755
UMask=0022

# The daemon's hardening, narrowed: this program reads logind, the journal,
# and /sys/class/drm, asks systemd to restart GDM, and writes only its own
# directory.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
BindReadOnlyPaths=/sys
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed

[Install]
# Enabled by the daemon package's postinst; Better Manager's off switch is a
# setting the program reads, so the unit stays enabled while it is off.
WantedBy=graphical.target
