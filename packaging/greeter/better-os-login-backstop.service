[Unit]
Description=Better OS login backstop
Documentation=https://github.com/TimLai666/better-os/blob/main/design/login-screen-spec.md
# The boot's last guard (design/login-screen-spec.md section 5.10): 82 s
# after the supervisor's first start (better-os-login-backstop.timer), a
# text login on tty9 if the property never held this boot. It runs no
# Better OS code, only standard programs, so no bug of the supervisor's can
# stop it. When the supervisor fails later in the boot, its OnFailure= is
# better-os-login-backstop-failed.service, which looks at the present.

[Service]
Type=oneshot
# Only when the greeter never reported ready this boot, no fall back runs,
# and the supervisor never saw the property hold (an automatic login has no
# greeter).
ExecCondition=/usr/bin/test ! -e /run/better-os-greeter/ready-seen
ExecCondition=/usr/bin/test ! -e /run/better-os/login-fallback.active
ExecCondition=/usr/bin/test ! -e /run/better-os/login-held
ExecStart=-/usr/bin/cp --update=none /usr/share/better-os/login-supervisor-failed.issue /run/better-os/login-fallback.issue
# The text login first, then the splash: a plymouthd that does not answer
# costs its 4 s after the prompt is started, not before.
ExecStart=/usr/bin/systemctl --no-block start better-os-login-fallback@tty9.service
ExecStart=/usr/bin/touch /run/better-os/login-fallback.active
# chvt waits for the switch; a VT held in process mode by a process that
# does not answer never lets it complete, so each try has a limit, and the
# second comes after plymouthd, which may be that process, is gone.
ExecStart=-/usr/bin/timeout 2 /usr/bin/chvt 9
ExecStart=-/usr/bin/timeout 4 /usr/bin/plymouth quit
ExecStart=-/usr/bin/pkill -KILL -x plymouthd
ExecStart=-/usr/bin/timeout 2 /usr/bin/chvt 9
TimeoutStartSec=30
RuntimeDirectory=better-os
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
